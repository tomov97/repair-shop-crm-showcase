# Demo environment. Point this at a THROWAWAY Supabase project, never production.
# Copy to apps/web/.env.demo and fill in.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Same values, read by scripts/seed-demo.mjs
DEMO_SUPABASE_URL=
DEMO_SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only needed if you want the intake photo feature live in the demo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
